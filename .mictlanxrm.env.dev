MICTLANX_RM_ENV_FILE_LOCAL_PATH=.mictlanxrm.env.dev
MICTLANX_RM_ENV_FILE_PATH=/app/.env.dev
MICTLANX_RM_ENV_FILE_VOLUME_TYPE=bind
# 
MICTLANX_RM_PEERS_FILE_LOCAL_PATH=./peers.dev.json
MICTLANX_RM_PEERS_FILE_PATH=/app/peers.json
MICTLANX_RM_PEERS_FILE_VOLUME_TYPE=bind
# 
MICTLANX_RM_LOG_LOCAL_PATH=mictlanx-rm-0_logs
MICTLANX_RM_LOG_PATH=/app/log
MICTLANX_RM_LOG_VOLUME_TYPE=volume
# 
MICTLANX_RM_DATA_LOCAL_PATH=mictlanx-rm-0_data
MICTLANX_RM_DATA_PATH=/app/data
MICTLANX_RM_DATA_VOLUME_TYPE=volume

# === SPM (ZeroMQ) ===
MICTLANX_RM_PROTOCOL=tcp
MICTLANX_RM_IP_ADDR=0.0.0.0
MICTLANX_RM_PORT=5555
MICTLANX_RM_DEBUG=0
MICTLANX_RM_GC_TIMEOUT=30s

# === Summoner ===
MICTLANX_RM_SUMMONER_IP_ADDR=mictlanx-summoner-0
MICTLANX_RM_SUMMONER_PROTOCOL=http
MICTLANX_RM_SUMMONER_LOCAL_PORT=15000
MICTLANX_RM_SUMMONER_PORT=15000
MICTLANX_RM_SUMMONER_API_VERSION=3

# === Peers bootstrapping ===
MICTLANX_RM_PEERS_PROTOCOL=http
MICTLANX_RM_PEERS_API_VERSION=4
MICTLANX_RM_PEERS=mictlanx://mictlanx-peer-0@mictlanx-peer-0:24000,mictlanx-peer-1@mictlanx-peer-1:24001/?protocol=http&api_version=4


#=== Default peer resources ===
MICTLANX_RM_DEFAULT_PEER_MEMORY=2GB
MICTLANX_RM_DEFAULT_PEER_DISK=1000GB
MICTLANX_RM_DEFAULT_PEER_CPU=2

# === Logging ===
MICTLANX_RM_STORAGE_PEER_MANAGER_SHOW_LOGS=D

# === StoragePeerManager params ===
MICTLANX_RM_MAX_RETRIES=2
MICTLANX_RM_MAX_IDLE_TIME=10s
MICTLANX_RM_QUEUE_TICK_TIMEOUT=5s
MICTLANX_RM_MAX_TIMEOUT_TO_RECOVER=30s
MICTLANX_RM_SUMMONER_BASE_PORT=47000
MICTLANX_RM_SUMMONER_BASE_PROTOCOL=http
MICTLANX_RM_SUMMONER_PHYSICAL_NODES_INDEXES=0,2,3,4,5,6,7,8,9,11,12
# MICTLANX_RM_DEBUG=True
MICTLANX_RM_SUMMONER_MODE=docker
MICTLANX_RM_MAX_RECOVER_TIME_UNTIL_RESTART=10sec
# ======================
MICTLANX_RM_MAX_TIMEOUT_TO_SAVE_PEER_CONFIG=30min
MICTLANX_RM_PEER_ELASTIC=True
MICTLANX_RM_SUMMONER_PEER_DOCKER_IMAGE=nachocode/mictlanx:peer-0.1.0a2
MICTLANX_RM_PEER_MIN_INTERVAL_TIME=5
MICTLANX_RM_PEER_MAX_INTERVAL_TIME=20
MICTLANX_RM_DAEMON_TICK_TIMEOUT=10s
MICTLANX_RM_MAX_TIMEOUT_PEERS_HANDSHAKE=30s
MICTLANX_RM_MAX_TIMEOUT_TO_GET_STATS=1m
MICTLANX_RM_TICK_PEERS_HANDSHAKE=5s
MICTLANX_RM_RECOVER_TICK_TIMEOUT=1m
MICTLANX_RM_SUMMONER_NETWORK_ID=jub
MICTLANX_RM_STORAGE_PEER_MANAGER_LOG_VERBOSE=1